<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- dotnet build -p:TryNet11Api=true compiles Components/Probe/Net11Api.razor, which uses <CacheView> -->
  <ItemGroup Condition="'$(TryNet11Api)' != 'true'">
    <Content Remove="Components/Probe/**" />
    <None Include="Components/Probe/**" />
  </ItemGroup>
</Project>
