<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- dotnet build -p:TryAnchor=true compiles the .NET 11 syntax against .NET 10 -->
  <ItemGroup Condition="'$(TryAnchor)' != 'true'">
    <Content Remove="Components/Pages/TryAnchorMode.razor" />
    <None Include="Components/Pages/TryAnchorMode.razor" />
  </ItemGroup>
</Project>
