@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Configuration.EnvironmentVariables
@inject IConfiguration Config

@* Only for the demo: where each key could come from, and what IConfiguration returned.
   An app reading Config["Orders:ApiUrl"] needs none of this. *@
<table class="sources" data-sources>
    <thead><tr><th>Key</th><th>appsettings.json</th><th>Variable</th><th>Config[key]</th></tr></thead>
    @foreach (var key in (string[])["Orders:ApiUrl", "Orders:PageSize"])
    {
        <tr><th>@key</th><td>@FromFile(key)</td><td>@(FromVariable(key) ?? "none")</td>
            <td><b>@Config[key]</b></td></tr>
    }
</table>

@code {
    string? FromFile(string key) => ((IConfigurationRoot)Config).Providers
        .Where(p => p is not EnvironmentVariablesConfigurationProvider)
        .Select(p => p.TryGet(key, out var value) ? value : null).LastOrDefault(v => v != null);

    // How .NET 10 code read a variable: "__" stands for ":".
    static string? FromVariable(string key) => Environment.GetEnvironmentVariable(key.Replace(":", "__"));
}
