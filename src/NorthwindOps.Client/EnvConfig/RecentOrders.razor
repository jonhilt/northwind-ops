@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@inject HttpClient Http

<p><RuntimeBadge /> Calling <code>@calling</code></p>
<p class="error">@error</p>

<table class="quickgrid">
    <thead><tr><th>Order</th><th>Customer</th><th>Total</th></tr></thead>
    @foreach (var o in orders ?? [])
    {
        <tr><td>@o.Id</td><td>@o.Customer</td><td>@o.Total.ToString("C")</td></tr>
    }
</table>

@code {
    record OrderRow(int Id, string Customer, decimal Total);

    string? apiUrl, error;
    Uri? calling;
    OrderRow[]? orders = [];

    protected override async Task OnInitializedAsync()
    {
        // xray:wasm-env-vars-config
        // New in .NET 11: plain IConfiguration sees the variable, and it beats the file.
        // No AddEnvironmentVariables() and no extra package in the client.
        apiUrl = Config["Orders:ApiUrl"];
        // /xray:wasm-env-vars-config
        var pageSize = Config.GetValue("Orders:PageSize", 10);
        // A relative address resolves against the server that sent the page.
        calling = new Uri(Http.BaseAddress!, $"{apiUrl}?take={pageSize}");
        try { orders = await Http.GetFromJsonAsync<OrderRow[]>(calling); }
        catch (HttpRequestException) { error = $"Couldn't reach {apiUrl}"; }
    }
}
