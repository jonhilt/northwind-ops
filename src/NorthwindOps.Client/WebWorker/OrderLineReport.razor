@using System.Diagnostics
@using System.Text.Json
@using NorthwindOps.Worker
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<Clock @ref="clock" />
<button disabled="@busy" @onclick="Total">Total in a Web Worker</button>
<button disabled="@busy" @onclick="Misspelled">Call a misspelled method</button>
<p role="status">@status</p>
<ReportRuns Runs="runs" />

@code {
    Clock clock = default!;
    bool busy = true;
    string status = "Downloading the order lines…";
    byte[] csv = [];
    List<ReportRun> runs = [];
    WebWorkerClient? worker;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        using var http = new HttpClient { BaseAddress = new(Navigation.BaseUri) };
        csv = await http.GetByteArrayAsync("demo/web-worker/order-lines.csv");
        // xray:web-worker-template
        // New in .NET 11: WebWorkerClient is C# the blazorwebworker template writes into
        // your project, with two scripts. It starts a second .NET runtime in a Web Worker.
        worker = await WebWorkerClient.CreateAsync(JS);
        // /xray:web-worker-template
        (busy, status) = (false, $"{csv.Length / 1e6:0.0} MB of order lines. Ready.");
        StateHasChanged();
    }

    async Task Total()
    {
        (busy, status) = (true, "Totalling in the worker…");
        await Task.Delay(50); // let that show before the work starts
        var (ticks, timer) = (clock.Ticks, Stopwatch.StartNew());
        // xray:web-worker-template
        // New in .NET 11: call the method by its full name. The template's client numbers
        // the call, copies the bytes over and awaits the reply; this thread stays free.
        var json = await worker!.InvokeAsync<string>(
            "NorthwindOps.Worker.WorkerMethods.TotalOrderLines", [csv]);
        // /xray:web-worker-template
        var totals = JsonSerializer.Deserialize<OrderLineTotals>(json)!;
        runs.Add(new("In a Web Worker", timer.Elapsed, clock.Ticks - ticks, totals));
        (busy, status) = (false, "Ready.");
    }

    async Task Misspelled()
    {
        // xray:web-worker-template
        // New in .NET 11: the template carries the worker's error back to this call as an
        // exception. The name is only checked at run time: here "Lines" lost its "s".
        try
        {
            await worker!.InvokeAsync<string>(
                "NorthwindOps.Worker.WorkerMethods.TotalOrderLine", []);
        }
        catch (InvalidOperationException ex) { status = ex.Message.Split('\n')[0]; }
        // /xray:web-worker-template
    }

    // xray:web-worker-template
    // New in .NET 11 (template): ends the worker and its runtime when the visitor leaves.
    public ValueTask DisposeAsync() => worker?.DisposeAsync() ?? default;
    // /xray:web-worker-template
}
