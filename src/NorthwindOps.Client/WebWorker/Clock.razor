@*
    A clock that ticks ten times a second on the browser's UI thread.
    While that thread is busy, it stops. Ticks counts how many times it has ticked.
*@
@implements IDisposable

<p class="clock">
    Clock on the UI thread <b>@(now?.ToString("HH:mm:ss.f") ?? "--:--:--.-")</b>
</p>

@code {
    DateTime? now;
    Timer? timer;

    public int Ticks { get; private set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) timer = new(_ => InvokeAsync(Tick), null, 0, 100);
    }

    void Tick()
    {
        now = DateTime.Now;
        Ticks++;
        StateHasChanged();
    }

    public void Dispose() => timer?.Dispose();
}
