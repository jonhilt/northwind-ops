@* Every run so far, and the top five products from the last one. *@

<ul class="runs" data-runs>
    @foreach (var run in Runs)
    {
        <li>
            @run.How: <b>@run.Took.TotalSeconds.ToString("0.0") s</b>.
            The clock ticked <b data-ticked>@run.Ticked of ~@run.Expected</b> times.
        </li>
    }
</ul>
<ol class="top">
    @foreach (var p in Runs.LastOrDefault()?.Totals.TopProducts ?? [])
    {
        <li>@p.Product <b>$@p.Revenue.ToString("N0")</b></li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ReportRun> Runs { get; set; } = [];
}
