@using System.Globalization

<p><RuntimeBadge /> Formatting in <b>@CultureInfo.CurrentCulture.Name</b></p>

@* xray:wasm-culture-from-server *@
@* Plain formatting, no culture passed in. On the server and in the browser alike, *@
@* it uses the culture the server rendered the page in. *@
<table class="quickgrid">
    <thead>
        <tr><th>Product</th><th>Qty</th><th>Unit price</th><th>Amount (USD)</th></tr>
    </thead>
    <tbody>
        @foreach (var line in Lines)
        {
            <tr>
                <td>@line.Product</td>
                <td>@line.Quantity.ToString("N0")</td>
                <td>@line.UnitPrice.ToString("N2")</td>
                <td>@((line.Quantity * line.UnitPrice).ToString("N2"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><th colspan="3">Total</th><th>@Total.ToString("N2")</th></tr>
    </tfoot>
</table>
<p>Payment due <b>@Due.ToString("D")</b></p>
@* /xray:wasm-culture-from-server *@

@* What the server rendered, kept from the prerender, next to what's on screen now. *@
<table class="moments" data-moments>
    <thead><tr><th></th><th>Culture</th><th>Total</th><th>Due</th></tr></thead>
    <tbody>
        @if (ServerRendered?.Split('|') is [var culture, var total, var due])
        {
            <tr><th>Server rendered</th><td>@culture</td><td>@total</td><td>@due</td></tr>
        }
        <tr data-now>
            <th>@(OperatingSystem.IsBrowser() ? "WebAssembly now" : "Server, now")</th>
            <td>@CultureInfo.CurrentCulture.Name</td><td>@Total.ToString("N2")</td><td>@Due.ToString("D")</td>
        </tr>
    </tbody>
</table>

@code {
    public sealed record Line(string Product, int Quantity, decimal UnitPrice);

    [Parameter] public Line[] Lines { get; set; } = [];

    [Parameter] public DateTime Due { get; set; }

    decimal Total => Lines.Sum(l => l.Quantity * l.UnitPrice);

    // Set while the server prerenders, and handed to WebAssembly with the page's persisted state.
    [PersistentState] public string? ServerRendered { get; set; }

    protected override void OnInitialized() =>
        ServerRendered ??= $"{CultureInfo.CurrentCulture.Name}|{Total:N2}|{Due:D}";
}
