@page "/"
@page "/guide"
@layout LearnLayout
@inject GuideRegistry Guide
@inject FeatureRegistry Features

<PageTitle>Field Guide · Northwind Ops</PageTitle>

<article class="l-article guide-index">
    <h1 class="l-title">Field Guide</h1>
    <p class="l-sub">What's new in Blazor for .NET 11, one feature at a time.</p>
    <p class="l-meta">@Guide.All.Count features · each one about 5 minutes</p>

    <p>
        Each page shows the problem first: the .NET 10 way, running and going wrong. Then the same demo on .NET 11,
        and the few lines that fix it.
    </p>
    <p class="gi-app">
        Every demo comes from <a href="app">Northwind Ops</a>, a small orders-and-suppliers app built on .NET 11.
        Open it to see the features working together, and press <b>X</b> on any screen to see which ones it uses.
    </p>

    @foreach (var group in Guide.All.GroupBy(e => e.Group))
    {
        <h2><small>@group.Key</small></h2>
        <ul class="gi-list">
            @foreach (var entry in group)
            {
                <li>
                    <a href="learn/@entry.Id">
                        <span class="gi-title">@entry.Title</span>
                        <span class="gi-mode">@entry.Mode</span>
                        <span class="gi-hook">@entry.Hook</span>
                    </a>
                </li>
            }
        </ul>
    }

    @if (others.Count > 0)
    {
        <h2><small>More in Northwind Ops</small></h2>
        <p>Not in the guide yet. Each has a write-up, and X-ray shows where the app uses it.</p>
        <ul class="gi-more">
            @foreach (var feature in others)
            {
                <li><a href="xray/@feature.Id">@feature.Title</a></li>
            }
        </ul>
    }
</article>

@code {
    List<Feature> others = [];

    protected override void OnInitialized()
        => others = Features.All
            .Where(f => Guide.Find(f.Id) is null)
            .OrderBy(f => f.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
}
