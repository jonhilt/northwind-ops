@page "/demo/tempdata/orders"
@layout DemoLayout
@inject IDbContextFactory<NorthwindDb> DbFactory

@* xray:tempdata-ssr *@
@if (message is not null)
{
    <div class="flash" role="status">✓ @message</div>
}
@* /xray:tempdata-ssr *@

<h1>Orders</h1>
<table class="quickgrid">
    <thead><tr><th>Order</th><th>Customer</th><th>Internal note</th></tr></thead>
    <tbody>
        @foreach (var order in orders)
        {
            <tr>
                <td><a href="demo/tempdata/orders/@order.Id">@order.Id</a></td>
                <td>@order.Customer.Company</td>
                <td>@order.Notes</td>
            </tr>
        }
    </tbody>
</table>

@code {
    string? message;
    List<Order> orders = [];

    // xray:tempdata-ssr
    // Statically rendered components get the request's TempData as a cascading parameter.
    [CascadingParameter] public ITempData? TempData { get; set; }
    // /xray:tempdata-ssr

    protected override async Task OnInitializedAsync()
    {
        // xray:tempdata-ssr
        // Get reads the value and marks it for deletion, so the message shows once.
        message = TempData?.Get("flash") as string;
        // /xray:tempdata-ssr

        await using var db = await DbFactory.CreateDbContextAsync();
        orders = await db.Orders.Include(o => o.Customer).OrderByDescending(o => o.Id).Take(6).ToListAsync();
    }
}
