@page "/demo/displayname/suppliers/net10"
@layout DemoLayout
@inject IDbContextFactory<NorthwindDb> DbFactory

@* Deutsch adds ?culture=de-DE, which sets the request's language *@
<nav class="languages">
    <a href="demo/displayname/suppliers/net10" class="@(german ? null : "on")">English</a>
    <a href="demo/displayname/suppliers/net10?culture=de-DE" class="@(german ? "on" : null)">Deutsch</a>
</nav>

<h1>@(german ? "Lieferanten" : "Suppliers")</h1>

<QuickGrid Items="suppliers">
    @* xray:displayname-component *@
    @* .NET 10: the model's names typed again, in English, as each column's Title *@
    <PropertyColumn Title="Supplier code" Property="s => s.Code" />
    <PropertyColumn Title="Company name" Property="s => s.Company" />
    <PropertyColumn Title="Main contact" Property="s => s.Contact" />
    @* /xray:displayname-component *@
</QuickGrid>

@code {
    // The page title and the picked language show which language the request is in.
    static bool german => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de";

    IQueryable<Supplier> suppliers = Enumerable.Empty<Supplier>().AsQueryable();

    protected override async Task OnInitializedAsync()
        => suppliers = await SupplierRows.LoadAsync(DbFactory);
}
