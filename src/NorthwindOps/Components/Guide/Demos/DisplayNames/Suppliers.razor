@page "/demo/displayname/suppliers"
@layout DemoLayout
@inject IDbContextFactory<NorthwindDb> DbFactory

@* Deutsch adds ?culture=de-DE, which request localization reads (see Program.cs) *@
<nav class="languages">
    <a href="demo/displayname/suppliers" class="@(german ? null : "on")">English</a>
    <a href="demo/displayname/suppliers?culture=de-DE" class="@(german ? "on" : null)">Deutsch</a>
</nav>

<h1>Suppliers</h1>

<div class="grid">
<QuickGrid Items="suppliers">
    @* xray:displayname-component *@
    @* New in .NET 11: each header is the form model's [Display] name, as plain text *@
    <PropertyColumn Property="s => s.Code">
        <HeaderTemplate><DisplayName For="() => form.Code" /></HeaderTemplate>
    </PropertyColumn>
    <PropertyColumn Property="s => s.Company">
        <HeaderTemplate><DisplayName For="() => form.Company" /></HeaderTemplate>
    </PropertyColumn>
    <PropertyColumn Property="s => s.Contact">
        <HeaderTemplate><DisplayName For="() => form.Contact" /></HeaderTemplate>
    </PropertyColumn>
    @* /xray:displayname-component *@
</QuickGrid>
</div>

@code {
    // Marks the language picked, so you can see German is on even where the headers stay English.
    static bool german => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de";

    // xray:displayname-component
    // Left null on purpose: DisplayName reads which property () => form.Code names,
    // and never calls the lambda, so nothing dereferences form.
    SupplierForm form = null!;
    // /xray:displayname-component

    IQueryable<Supplier> suppliers = Enumerable.Empty<Supplier>().AsQueryable();

    protected override async Task OnInitializedAsync()
        => suppliers = await SupplierRows.LoadAsync(DbFactory);
}
