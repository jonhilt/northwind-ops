@using System.ComponentModel.DataAnnotations
@using System.Reflection

@* Scaffolding for the guide, not part of either technique: SupplierForm's [Display] names
   right now, the ones its labels and validation messages show. Compare the headers. *@
<p class="form-labels" data-form-labels>
    <span class="tag">Guide readout</span> The form model's names:
    @foreach (var name in Names())
    {
        <b>@name</b>
    }
</p>

@code {
    static IEnumerable<string> Names() =>
        new[] { "Code", "Company", "Contact" }.Select(property =>
            typeof(SupplierForm).GetProperty(property)!
                .GetCustomAttribute<DisplayAttribute>()!.GetName()!);
}
