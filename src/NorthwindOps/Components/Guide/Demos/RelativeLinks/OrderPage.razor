@page "/demo/relative-nav/orders/{Id:int}/{Tab?}"
@layout DemoLayout
@inject NavigationManager Navigation

<a href="demo/relative-nav/orders">← Orders</a>
<h1>Order @Id</h1>

@* No parameters: the tabs work out which order they're on from the URL. *@
<OrderTabs />
@if (Tab is not null)
{
    <OrderDetails Id="Id" Tab="@Tab" />
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        if (Tab is not null) return;

        // xray:relative-navigation
        // Mind the folder: the option drops everything after the URL's last '/'.
        // From /orders/12047 that's the id, so it must go back in; from /orders/12047/,
        // the folder is already the order's own.
        var inFolder = new Uri(Navigation.Uri).AbsolutePath.EndsWith('/');
        // /xray:relative-navigation

        // xray:relative-navigation
        // New in .NET 11: NavigateTo takes the same option, to redirect to a sibling.
        var options = new NavigationOptions { RelativeToCurrentUri = true };
        Navigation.NavigateTo(inFolder ? "summary" : $"{Id}/summary", options);
        // /xray:relative-navigation
    }
}
