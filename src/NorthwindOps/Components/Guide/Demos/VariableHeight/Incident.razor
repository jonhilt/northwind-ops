@page "/demo/variable-height/incident"
@layout DemoLayout

<h1>Order sync incident</h1>

@* The page is static. Only the thread, which scrolls and expands, runs interactively. *@
<IncidentThread @rendermode="InteractiveServer" />

@* Live numbers under the list: the same readout the .NET 10 recording shows. *@
<p class="readout" data-scroll-readout></p>
<script src="js/scroll-readout.js"></script>
