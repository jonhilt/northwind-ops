@implements IDisposable
@inject IJSRuntime JS

<p class="count" data-newest="@messages[^1].N">@messages.Count messages</p>
<div class="feed" style="height: 300px; overflow-y: auto" @ref="feed">
    @* xray:virtualize-anchor-mode *@
    @* .NET 10: no AnchorMode. It keeps the scroll position, so new rows land below. *@
    <Virtualize Items="messages" Context="m">
    @* /xray:virtualize-anchor-mode *@
        <div class="msg" data-n="@m.N">
            <b>@m.From</b> <span>@m.Text</span> <time>@m.At.ToString("HH:mm:ss")</time>
        </div>
    </Virtualize>
</div>

@code {
    // The same 300 earlier messages, some long.
    List<InboxMessage> messages = InboxMessage.Earlier();
    Timer? timer;

    ElementReference feed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Start at the newest message, like the .NET 11 feed. Nothing keeps it there after that.
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Guide/Demos/AnchorMode/MessageFeedNet10.razor.js");
        await module.InvokeVoidAsync("scrollToEnd", feed);
        // The same arrivals: a message every 2.5 seconds.
        timer = new(_ => InvokeAsync(Arrive), null, 2500, 2500);
    }

    void Arrive()
    {
        if (messages.Count == 400) return; // keep the demo small
        messages.Add(InboxMessage.Make(messages.Count));
        StateHasChanged();
    }

    public void Dispose() => timer?.Dispose();
}
