@implements IDisposable

<p class="count" data-newest="@messages[^1].N">@messages.Count messages</p>
@* xray:virtualize-anchor-mode *@
@* Not new: the box that scrolls. AnchorMode follows its end, so give it a height. *@
<div class="feed" style="height: 300px; overflow-y: auto">
@* /xray:virtualize-anchor-mode *@
    @* xray:virtualize-anchor-mode *@
    @* New in .NET 11: follow the end of the list while the reader is at its bottom. *@
    <Virtualize Items="messages" AnchorMode="VirtualizeAnchorMode.End" Context="m">
    @* /xray:virtualize-anchor-mode *@
        <div class="msg" data-n="@m.N">
            <b>@m.From</b> <span>@m.Text</span> <time>@m.At.ToString("HH:mm:ss")</time>
        </div>
    </Virtualize>
</div>

@code {
    // 300 earlier messages, some long, so there's something to scroll up and read.
    List<InboxMessage> messages = InboxMessage.Earlier();
    Timer? timer;

    protected override void OnAfterRender(bool firstRender)
    {
        // Once the circuit is up, a message arrives every 2.5 seconds.
        if (firstRender) timer = new(_ => InvokeAsync(Arrive), null, 2500, 2500);
    }

    void Arrive()
    {
        if (messages.Count == 400) return; // keep the demo small
        // xray:virtualize-anchor-mode
        // Not new: just add it. If you're at the bottom, AnchorMode scrolls to it.
        messages.Add(InboxMessage.Make(messages.Count));
        StateHasChanged();
        // /xray:virtualize-anchor-mode
    }

    public void Dispose() => timer?.Dispose();
}
