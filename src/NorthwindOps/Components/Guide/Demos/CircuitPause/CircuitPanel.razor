@* The pause demos' status panel: this tab's circuit, and how many circuits this server holds. *@
@implements IDisposable
@inject CircuitTracker Tracker
@inject CircuitBoard Board
@inject PersistentComponentState State

<dl class="circuit-panel">
    <dt>This tab</dt>
    <dd>
        Circuit <code>@CircuitId?[..6]</code>
        @if (Resumes == 0)
        {
            <span class="muted">&nbsp;· not paused yet</span>
        }
        else
        {
            <span class="resumed" data-resumes="@Resumes">
                &nbsp;· paused for @(pausedFor?.TotalSeconds.ToString("0 s") ?? "a while"),
                then resumed on a new circuit@(Resumes > 1 ? $" ({Resumes} times)" : "")
            </span>
        }
    </dd>
    @if (request is not null)
    {
        <dt>The server's request</dt>
        <dd data-request="@(request.Answer ?? "waiting")">
            @if (request.Answer is null)
            {
                <span class="stuck">asked @Since(request.At) ago, and still waiting for an answer</span>
            }
            else
            {
                <span>answered <code>@request.Answer</code> in @request.After!.Value.TotalMilliseconds.ToString("0") ms</span>
            }
        </dd>
    }
    <dt>This server</dt>
    <dd>@Count(Board.Open, "circuit") open · @Count(Board.Paused, "tab") paused</dd>
</dl>

@code {
    // Saved when the circuit pauses, so the resumed tab knows it was here before.
    [PersistentState] public string? CircuitId { get; set; }
    [PersistentState] public int Resumes { get; set; }

    TimeSpan? pausedFor;
    PauseRequest? request; // what became of the server's request to pause the last circuit
    PersistingComponentStateSubscription persisting;

    protected override void OnInitialized()
    {
        if (CircuitId is not null) // restored after a pause, onto a new circuit
        {
            Resumes++;
            pausedFor = Board.Resumed(CircuitId);
            request = Board.Request(CircuitId);
        }
        CircuitId = Tracker.Circuit?.Id;
        // An Interactive Server circuit persists its state when it pauses.
        persisting = State.RegisterOnPersisting(() =>
        {
            if (CircuitId is not null) Board.Pausing(CircuitId);
            return Task.CompletedTask;
        }, RenderMode.InteractiveServer);
        Board.Changed += Refresh;
    }

    static string Since(DateTimeOffset at) => $"{(DateTimeOffset.UtcNow - at).TotalSeconds:0} s";

    static string Count(int n, string noun) => $"{n} {noun}{(n == 1 ? "" : "s")}";

    // Raised from other circuits' threads. If this circuit has gone, there's nothing to redraw,
    // and an exception escaping an async void method would stop the whole server.
    async void Refresh()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch { }
    }

    public void Dispose()
    {
        persisting.Dispose();
        Board.Changed -= Refresh;
    }
}
