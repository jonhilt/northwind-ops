@* The pause demos' one-line status. A tab that resumes looks just like one that never paused,
   so this says when it did. And a server request that never gets an answer can't be seen
   from the page, so this says what became of it. Nothing shows until there's something to say. *@
@inject CircuitTracker Tracker
@inject CircuitBoard Board
@inject PersistentComponentState State
@implements IDisposable

@if (request is not null)
{
    <p class="circuit-panel" data-request="@(request.Answer ?? "waiting")">
        @if (request.Answer is null)
        {
            <span class="stuck">The server asked this tab to pause @Since(request.At) ago, and is still waiting for an answer.</span>
        }
        else
        {
            <span>The server asked this tab to pause, and got <code>@request.Answer</code> back in @request.After!.Value.TotalMilliseconds.ToString("0") ms.</span>
        }
    </p>
}
else if (Resumes > 0)
{
    <p class="circuit-panel resumed" data-resumes="@Resumes">
        This tab was paused for @(pausedFor?.TotalSeconds.ToString("0 s") ?? "a while"), then resumed.
    </p>
}

@code {
    // Saved when the circuit pauses, so the resumed tab knows it was here before.
    [PersistentState] public string? CircuitId { get; set; }
    [PersistentState] public int Resumes { get; set; }

    TimeSpan? pausedFor;
    PauseRequest? request; // what became of the server's request to pause the last circuit
    PersistingComponentStateSubscription persisting;

    protected override void OnInitialized()
    {
        if (CircuitId is not null) // restored after a pause, onto a new circuit
        {
            Resumes++;
            pausedFor = Board.Resumed(CircuitId);
            request = Board.Request(CircuitId);
        }
        CircuitId = Tracker.Circuit?.Id;
        // An Interactive Server circuit persists its state when it pauses.
        persisting = State.RegisterOnPersisting(() =>
        {
            if (CircuitId is not null) Board.Pausing(CircuitId);
            return Task.CompletedTask;
        }, RenderMode.InteractiveServer);
    }

    static string Since(DateTimeOffset at) => $"{(DateTimeOffset.UtcNow - at).TotalSeconds:0} s";

    public void Dispose() => persisting.Dispose();
}
