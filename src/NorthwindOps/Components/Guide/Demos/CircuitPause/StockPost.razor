@* Posts the count to the warehouse, which takes 20 seconds. *@
@implements IDisposable

<div class="post">
    <button @onclick="PostAsync" disabled="@posting">@(posting ? "Posting…" : "Post count")</button>
    <span data-posted>@(posting ? "Posting…" : Posted is null ? "Not posted" : $"Posted at {Posted}")</span>
</div>
<p class="ledger" data-ledger>@Ledger(StockLedger.Posts(Sheet))</p>

@code {
    // Kept across a pause, like the counts.
    [PersistentState] public Guid Sheet { get; set; }
    [PersistentState] public string? Posted { get; set; }

    bool posting;

    protected override void OnInitialized()
    {
        if (Sheet == Guid.Empty) Sheet = Guid.NewGuid();
        StockLedger.Changed += Refresh;
    }

    // xray:circuit-auto-pause
    // Look here (not new): a plain click handler. Posted is set only when it returns.
    // Pause before then and the state is saved without it. Until it returns, the browser is
    // still waiting on the server: AutoPause sees that and waits; a pause script doesn't look.
    async Task PostAsync()
    {
        posting = true;
        await StockLedger.PostAsync(Sheet);
        Posted = DateTime.Now.ToString("HH:mm:ss");
        posting = false;
    }
    // /xray:circuit-auto-pause

    static string Ledger(int n) => "The warehouse " + n switch
    {
        0 => "doesn't have this count yet.", 1 => "has this count once.",
        2 => "has this count twice.", _ => $"has this count {n} times."
    };

    // Raised from other circuits' threads. If this circuit has gone, there's nothing to redraw.
    async void Refresh()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch { }
    }

    public void Dispose() => StockLedger.Changed -= Refresh;
}
