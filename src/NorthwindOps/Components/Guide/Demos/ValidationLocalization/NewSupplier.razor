@page "/demo/validation-localization/suppliers/new"
@layout DemoLayout
@inject IDbContextFactory<NorthwindDb> DbFactory
@inject SupplierMessages T

@* Request localization reads ?culture=de-DE (see Program.cs) *@
<nav class="languages">
    <a href="demo/validation-localization/suppliers/new">English</a>
    <a href="demo/validation-localization/suppliers/new?culture=de-DE">Deutsch</a>
</nav>

@if (added is not null)
{
    <div class="flash" role="status">✓ @T["Saved"]: @added</div>
}

<h1>@T["New supplier"]</h1>

@* xray:validation-localization *@
@* The server translates each message as it renders the form. The browser shows them. *@
<EditForm Model="Input" FormName="new-supplier" OnValidSubmit="SaveAsync" Enhance>
    <DataAnnotationsValidator />
    @* /xray:validation-localization *@
    <label for="company">@T["Company"]</label>
    <InputText id="company" @bind-Value="Input!.Company" />
    <ValidationMessage For="() => Input!.Company" />

    <label for="email">@T["Email"]</label>
    <InputText id="email" @bind-Value="Input!.Email" />
    <ValidationMessage For="() => Input!.Email" />

    <button type="submit">@T["Save supplier"]</button>
</EditForm>

@code {
    string? added;

    [SupplyParameterFromForm] public NewSupplierForm? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    async Task SaveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Add(new Supplier { Company = Input!.Company!, Email = Input.Email });
        await db.SaveChangesAsync();

        added = Input.Company;
        Input = new();
    }
}
