@page "/demo/cacheview/stock"
@layout DemoLayout

<h1>Stock by category</h1>
<p class="stamp">Page rendered at <b>@DateTime.Now.ToString("HH:mm:ss")</b></p>

<div class="cached" data-label="Cached for 10 seconds by CacheView">
    @* xray:cacheview *@
    @* New in .NET 11: keeps the summary's HTML. On a hit, StockSummary isn't even created,
       and visitors who miss together wait for one render instead of each running it.
       The key is where it sits on the page, so every visitor shares one entry. *@
    <CacheView ExpiresAfter="TimeSpan.FromSeconds(10)">
        <StockSummary />
    </CacheView>
    @* /xray:cacheview *@
</div>

<Visitors Tally="ReportTally.Net11" />
