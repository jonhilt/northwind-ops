@*
    The slow report, with no caching code of its own: the page wraps it in a CacheView.
*@
@inject IDbContextFactory<NorthwindDb> DbFactory

<StockTable Rows="rows" CalculatedAt="calculatedAt" />

@code {
    List<CategoryStock> rows = [];
    DateTime calculatedAt;

    // An ordinary component, with no caching code. On a cache hit it isn't created.
    protected override async Task OnInitializedAsync()
    {
        Interlocked.Increment(ref ReportTally.Net11.Queries);
        rows = await StockQuery.RunAsync(DbFactory);
        calculatedAt = DateTime.Now;
    }
}
