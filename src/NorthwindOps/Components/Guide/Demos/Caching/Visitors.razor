@*
    Demo only: sends five visitors at once, just as the cached figures expire, and shows how many report
    queries they ran between them. The button is plain HTML, wired up by Visitors.razor.js, so it works
    on this static page. The query count is hidden: only the burst's result is shown.
*@
<div class="visitors" data-now="@DateTime.Now.ToString("o")">
    <span hidden data-queries>@Tally.Queries</span>
    <button type="button" data-burst>Five visitors at once</button>
    <span class="status" data-burst-status></span>
</div>
<script type="module" src="@Assets["Components/Guide/Demos/Caching/Visitors.razor.js"]"></script>

@code {
    [Parameter, EditorRequired] public ReportTally Tally { get; set; } = default!;
}
