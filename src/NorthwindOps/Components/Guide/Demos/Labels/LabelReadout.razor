@*
    Under both forms: what the browser makes of their labels. For each input, its id and the label that
    names it, any label whose `for` matches nothing, the message under it, and what has focus.
    Plain JS reading the rendered page, so it shows the markup as it is, not as the page meant it.
    Net10: the page runs .NET 10's markup on .NET 11, so the panel flags the ids .NET 10 didn't render.
*@
<aside class="readout" data-label-readout data-net10="@(Net10 ? "true" : null)" aria-live="polite"></aside>
<script src="@Assets["Components/Guide/Demos/Labels/LabelReadout.razor.js"]"></script>

@code {
    [Parameter] public bool Net10 { get; set; }
}
