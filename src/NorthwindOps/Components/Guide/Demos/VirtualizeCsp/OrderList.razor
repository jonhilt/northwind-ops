@inject IDbContextFactory<NorthwindDb> DbFactory

<p class="count">@orders.Count orders, newest first</p>

<div class="orders">
    @* xray:virtualize-csp *@
    @* Unchanged code. What changed is the spacers it renders around the visible rows:
       .NET 10: <div style="height: 39240px">, which the policy refuses.
       .NET 11: <div data-blazor-virtualize-reserved-height="39240">, sized by Blazor's script. *@
    <Virtualize Items="orders" Context="o" ItemSize="41">
    @* /xray:virtualize-csp *@
        <div class="order">
            <b>#@o.Id</b>
            <span>@o.Company</span>
            <time>@o.PlacedOn.ToString("d MMM yyyy")</time>
            <span class="total">@o.Total.ToString("C0")</span>
        </div>
    </Virtualize>
</div>

@code {
    record OrderRow(int Id, string Company, DateTime PlacedOn, decimal Total);

    List<OrderRow> orders = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        orders = await db.Orders
            .OrderByDescending(o => o.PlacedOn).ThenByDescending(o => o.Id)
            .Select(o => new OrderRow(o.Id, o.Customer.Company, o.PlacedOn, o.Total))
            .ToListAsync();
    }
}
