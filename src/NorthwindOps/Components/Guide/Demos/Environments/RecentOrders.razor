@page "/demo/environment-view/orders"
@layout DemoLayout
@using NorthwindOps.Client.Environments
@inject IHostEnvironment Env
@inject IDbContextFactory<NorthwindDb> DbFactory

@* xray:environment-view *@
<EnvironmentView Exclude="Production">
    <div class="env-banner">@Env.EnvironmentName · test data, not real customers</div>
</EnvironmentView>
@* /xray:environment-view *@

<h1>Recent orders</h1>
<table class="quickgrid">
    <thead><tr><th>Order</th><th>Customer</th><th>Total</th></tr></thead>
    <tbody>
        @foreach (var o in orders)
        {
            <tr>
                <td>@o.Id</td><td>@o.Customer.Company</td><td>@o.Total.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

@* xray:environment-view *@
<EnvironmentView Include="Production">
    <p class="live">These are real orders. Changes reach customers.</p>
</EnvironmentView>
@* /xray:environment-view *@

@* The debug panel runs in your browser, on WebAssembly. *@
<DebugPanel @rendermode="InteractiveWebAssembly" />

@code {
    List<Order> orders = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        orders = await db.Orders.Include(o => o.Customer)
            .OrderByDescending(o => o.Id).Take(4).ToListAsync();
    }
}
