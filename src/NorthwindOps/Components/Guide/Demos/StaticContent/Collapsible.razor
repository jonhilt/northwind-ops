@*
    A card you can fold away. It runs interactively, but what's inside it doesn't:
    the static page renders that and passes it in as ChildContent.
*@
<section class="card">
    <header>
        <button type="button" @onclick="Toggle" disabled="@(!RendererInfo.IsInteractive)">
            @(open ? "▾" : "▸") @Title
        </button>
        <span>@(RendererInfo.IsInteractive ? "Interactive" : "Connecting…")</span>
    </header>

    @* Starts open: the static page only records ChildContent if it renders on the first pass. *@
    @if (open)
    {
        @* xray:renderfragment-across-render-modes *@
        @* Replays the markup the static page recorded. Its code doesn't run again here. *@
        @ChildContent
        @* /xray:renderfragment-across-render-modes *@
    }
</section>

@code {
    bool open = true;

    [Parameter] public string Title { get; set; } = "";

    // xray:renderfragment-across-render-modes
    // Markup from the static page. .NET 10 refused to send this delegate and failed the page;
    // .NET 11 sends what it rendered instead.
    [Parameter] public RenderFragment? ChildContent { get; set; }
    // /xray:renderfragment-across-render-modes

    void Toggle() => open = !open;
}
