@page "/demo/browser-options/pick-list"
@layout DemoLayout

@* xray:browser-options *@
@* New in .NET 11: written into the page as it renders. blazor.web.js applies it as it starts. *@
<ConfigureBrowser Options="warehouseWifi" />
@* /xray:browser-options *@

<h1>Pick list · order 10950</h1>

@* Not new: blazor.web.js fills these in while it retries, from the options it was given. *@
<p class="rejoin">
    Rejoin attempt <b id="components-reconnect-current-attempt"></b>
    of <b id="components-reconnect-max-retries"></b>
</p>

@* The page is static. Only the pick list runs on the server, over a connection. *@
<PickLines @rendermode="InteractiveServer" />

<WifiDropout />

@code {
    // xray:browser-options
    // New in .NET 11: typed settings in C#. Warehouse Wi-Fi drops out for a few seconds
    // at a time: retry every 2 seconds, 20 times. (Blazor's default is 30 tries: 10 at
    // once, with no wait, then 10 five seconds apart, then 10 thirty seconds apart.)
    // static readonly: built once, and every request for this page passes the same one.
    static readonly BrowserOptions warehouseWifi = new()
    {
        InteractiveServer =
        {
            ReconnectionMaxRetries = 20,
            ReconnectionRetryInterval = TimeSpan.FromSeconds(2),
        },
    };
    // /xray:browser-options
}
