<div class="sort-indicator" aria-hidden="true"></div></button></div></th></tr></thead>
<tbody><tr aria-rowindex="2"><td class="col-justify-start ">Product 01</td><td class="col-justify-start ">4</td></tr><tr aria-rowindex="3"><td class="col-justify-start ">Product 02</td><td class="col-justify-start ">7</td></tr><tr aria-rowindex="4"><td class="col-justify-start ">Product 03</td><td class="col-justify-start ">10</td></tr><tr aria-rowindex="5"><td class="col-justify-start ">Product 04</td><td class="col-justify-start ">13</td></tr><tr aria-rowindex="6"><td class="col-justify-start ">Product 05</td><td class="col-justify-start ">16</td></tr><tr aria-rowindex="7"><td class="col-justify-start ">Product 06</td><td class="col-justify-start ">19</td></tr><tr aria-rowindex="8"><td class="col-justify-start ">Product 07</td><td class="col-justify-start ">22</td></tr><tr aria-rowindex="9"><td class="col-justify-start ">Product 08</td><td class="col-justify-start ">25</td></tr><tr aria-rowindex="10"><td class="col-justify-start ">Product 09</td><td class="col-justify-start ">28</td></tr><tr aria-rowindex="11"><td class="col-justify-start ">Product 10</td><td class="col-justify-start ">31</td></tr></tbody></table>
