@using NorthwindOps.Features.Support
@inject SupportDesk Desk

@* ScrollToItemAsync throws until the circuit starts, so the buttons wait for it. *@
<form class="tools" @onsubmit="() => GoToAsync(jumpTo ?? 1)">
    <label for="jump">Jump to message #</label>
    <input id="jump" type="number" @bind="jumpTo" />
    <button disabled="@(!RendererInfo.IsInteractive)">Go</button>
    <button type="button" disabled="@(!RendererInfo.IsInteractive)"
            @onclick="() => GoToAsync(messages.Count)">Latest</button>
</form>

@* InitialItemIndex applies once, so the list waits until it has its messages. *@
@if (messages.Count > 0)
{
    <div class="thread" data-asked="@(target ?? Message)" data-count="@messages.Count">
        @* xray:virtualize-scroll-to-item *@
        @* New in .NET 11: open at the linked message (zero-based, so #300 is index 299).
           Even the prerendered HTML starts around it. *@
        <Virtualize @ref="list" Items="messages" Context="m"
                    InitialItemIndex="(Message ?? 1) - 1">
        @* /xray:virtualize-scroll-to-item *@
            <article class="@(m.Number == (target ?? Message) ? "msg target" : "msg")">
                <header><b>@m.Author</b> #@m.Number</header>
                <p>@m.Body</p>
            </article>
        </Virtualize>
    </div>
}

@code {
    Virtualize<TicketMessage>? list;
    List<TicketMessage> messages = [];
    int? jumpTo, target;

    [SupplyParameterFromQuery] public int? Message { get; set; } // like ?message=300

    protected override async Task OnInitializedAsync()
    {
        // The desk's longest thread: one-line log entries mixed with long emails.
        var longest = (await Desk.ListAsync()).MaxBy(t => t.MessageCount)!;
        messages = (await Desk.GetAsync(longest.Id))!.Messages;
    }

    async Task GoToAsync(int number)
    {
        target = Math.Clamp(number, 1, messages.Count); // the app's own highlight
        // xray:virtualize-scroll-to-item
        // New in .NET 11: renders the messages around it, then aligns it to the top.
        await list!.ScrollToItemAsync(target.Value - 1);
        // /xray:virtualize-scroll-to-item
    }
}
